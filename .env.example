# Database
# Neon (PostgreSQL) recommended. For Prisma's connection pooler endpoint
# (host ending in `-pooler`), use: ?sslmode=require&pgbouncer=true&connect_timeout=10
# Or connect directly to the non-pooler hostname to avoid the pooler entirely.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?sslmode=require"

# JWT signing secret for the admin session (required in production).
# Generate with: openssl rand -base64 32
# The app FAILS CLOSED if this is missing — no fallback secret is used.
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
CONTACT_EMAIL="tinashemundieta36@gmail.com"

# Admin credentials (used by `npm run db:seed` to create the first admin)
ADMIN_EMAIL="admin@tinashemundieta.com"
ADMIN_PASSWORD="use-a-strong-unique-password"