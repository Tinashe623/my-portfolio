# Copy this to .env and set your phone number(s) if you want them displayed on the Contact page.
# Example formats: +1 555 555 5555, +263 77 123 4567
VITE_CONTACT_PHONE=YOUR_PRIMARY_PHONE
VITE_CONTACT_PHONE_ALT=YOUR_ALTERNATE_PHONE
# Optional social links
VITE_WHATSAPP_PHONE=YOUR_WHATSAPP_NUMBER
VITE_FACEBOOK_URL=https://facebook.com/your-profile
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-handle/
# Optional CV download URL (relative to the public/ root, no leading slash). Example: 'cv/Tinashe_Mundieta_cv.docx' or just 'Tinashe_Mundieta_cv.docx'
VITE_CV_URL=Tinashe_Mundieta_cv.docx
# Optional: live demo link for the School Website highlight
VITE_SCHOOL_WEBSITE_DEMO=

# Contact email (fallback if not set)
VITE_CONTACT_EMAIL=tinashemundieta36@gmail.com

# EmailJS Configuration (https://www.emailjs.com/)
# Get these from your EmailJS dashboard after creating a service and template
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# Optional: EmailJS user ID (alternative auth method)
VITE_EMAILJS_USER_ID=your_user_id
