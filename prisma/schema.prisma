generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  content          String?  @db.Text
  image            String?
  images           String[]
  tags             String[]
  category         String
  status           String   @default("completed")
  featured         Boolean  @default(false)
  liveUrl          String?
  codeUrl          String?
  clientName       String?
  testimonial      String?  @db.Text
  testimonialAuthor String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("projects")
}

model Certificate {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  issuer         String
  issueDate      DateTime
  expiryDate     DateTime?
  credentialId   String?
  credentialUrl  String?
  image          String?
  description    String?  @db.Text
  tags           String[]
  verified       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("certificates")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.Text
  coverImage  String?
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  content   String   @db.Text
  avatar    String?
  rating    Int      @default(5)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  level       String   @default("intermediate")
  icon        String?
  description String?  @db.Text
  featured    Boolean  @default(true)
  order       Int      @default(0)

  @@map("skills")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("admins")
}
